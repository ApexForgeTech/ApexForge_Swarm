LLM_PROVIDER=llama_cpp
# Options: ollama | llama_cpp | openai_compat

# ── Shared model selection ─────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5-3b-instruct-q4_k_m.gguf
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=16384

# ── Ollama backend ─────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── llama.cpp backend ──────────────────────────────────────────────────────
LLAMA_CPP_HOST=http://127.0.0.1:8081
LLAMA_CPP_SERVER_BINARY=llama-server
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_HF_MODEL=
LLAMA_CPP_AUTO_START=false
LLAMA_CPP_JINJA=true
LLAMA_CPP_CHAT_TEMPLATE=
LLAMA_CPP_CHAT_TEMPLATE_FILE=
LLAMA_CPP_STARTUP_TIMEOUT=60
LLAMA_CPP_REQUEST_TIMEOUT=600
LLAMA_CPP_MAX_TOKENS=2048
LLAMA_CPP_API_KEY=sk-no-key-required
LLAMA_CPP_EXTRA_ARGS=

# ── OpenAI-compatible backend ──────────────────────────────────────────────
# Works with: OpenAI, Groq, Together.ai, Mistral, LM Studio, vllm, etc.
# OPENAI_COMPAT_API_KEY=sk-your-key-here
# OPENAI_COMPAT_BASE_URL=                              # empty = OpenAI official
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1    # Groq
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1            # LM Studio
# OPENAI_COMPAT_MODEL=gpt-4o-mini
# OPENAI_COMPAT_MAX_TOKENS=4096

# ── Web UI ─────────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=8080
# APEXFORGE_API_KEY=your-secret-key    # Web API auth (empty = disabled)

# ── RAG / Knowledge Base ───────────────────────────────────────────────────
# RAG works out-of-box with keyword search (no deps). For vector search:
#   pip install chromadb         → enables ChromaDB vector store
#   ollama pull nomic-embed-text → enables semantic embeddings
RAG_ENABLED=true
RAG_PERSIST_DIR=rag_store
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_BACKEND=ollama          # ollama | openai_compat
# RAG_EMBED_BASE_URL=             # for openai_compat embed backend
# RAG_EMBED_API_KEY=              # for openai_compat embed backend
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ── Runtime flags ──────────────────────────────────────────────────────────
AUX_AUTONOMY_ENABLED=false
# APEXFORGE_SERIALIZE_LLM_REQUESTS=false   # Force sequential LLM calls
# APEXFORGE_ALLOW_DESKTOP_WEB_FALLBACK=false
